{
  "name": "my-obsidian-bookmark",
  "version": "1.0.0",
  "description": "Named bookmarks at precise positions inside Markdown notes, with a dedicated sidebar.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "author": "Marco Da Re",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install:vault": "pnpm run build && node scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "bookmarks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "obsidian": "1.13.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@9.1.3",
  "engines": {
    "node": ">=21.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
